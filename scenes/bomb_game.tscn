[sub_resource type="GDScript" id="GDScript_huhyi"]
script/source = "extends Node2D

signal gotRightPasswordBombGame
@onready var bombTickBeep: AudioStreamPlayer2D = $\"bomb tick beep\"

func _on_keypad_got_right_password_keypad() -> void:
	gotRightPasswordBombGame.emit()



func _on_one_sec_timer_timeout() -> void:
	bombTickBeep.play()
"

[node name="BombGame" type="Node2D"]
